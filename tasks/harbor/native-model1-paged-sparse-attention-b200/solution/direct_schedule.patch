--- a/native_paged_sparse_prefill/upstreams/FlashMLA/csrc/sm100/direct_schedule.cuh
+++ b/native_paged_sparse_prefill/upstreams/FlashMLA/csrc/sm100/direct_schedule.cuh
@@ -0,0 +1,38 @@
+#pragma once
+
+#include "params.h"
+#include <kerutils/kerutils.cuh>
+
+namespace sm100 {
+
+__device__ __forceinline__ DecodingSchedMeta load_sparse_schedule(
+    const SparseAttnDecodeParams& params, int partition
+) {
+    DecodingSchedMeta metadata{};
+    if (params.tile_scheduler_metadata_ptr) {
+        KU_LDG_256(params.tile_scheduler_metadata_ptr + partition, &metadata,
+                   ".nc", "no_allocate", "evict_normal", "256B");
+        return metadata;
+    }
+    const int splits = params.num_sm_parts / params.b;
+    const int request = partition / splits;
+    const int split = partition % splits;
+    const int primary = params.topk_length ? __ldg(params.topk_length + request) : params.topk;
+    const int extra = params.extra_topk_length ? __ldg(params.extra_topk_length + request) : params.extra_topk;
+    const int blocks = max((primary + 63) / 64, 1) + (extra + 63) / 64;
+    metadata.begin_req_idx = metadata.end_req_idx = request;
+    metadata.begin_block_idx = blocks * split / splits;
+    metadata.end_block_idx = blocks * (split + 1) / splits;
+    metadata.begin_split_idx = split;
+    metadata.is_first_req_splitted = metadata.is_last_req_splitted = splits > 1;
+    return metadata;
+}
+
+__device__ __forceinline__ int sparse_split_offset(
+    const SparseAttnDecodeParams& params, int request
+) {
+    return params.num_splits_ptr ? __ldg(params.num_splits_ptr + request) :
+        request * (params.num_sm_parts / params.b);
+}
+
+}
